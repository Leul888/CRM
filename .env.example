# ---------- core ----------
PORT=8080
# Where the SQLite database and uploaded files live. Must be a persistent disk in production.
DATA_DIR=./data
# Public URL of the app (used in e-sign, invite and password-reset links).
APP_URL=https://crm.companyx.com
# Send the session cookie only over HTTPS (set true behind HTTPS in production).
COOKIE_SECURE=true
# Number of reverse proxies in front of the app (Render/Fly/Nginx = 1).
TRUST_PROXY=1
# Time zone used in customer-facing messages.
APP_TIMEZONE=America/New_York

# ---------- first boot (only used when the database is empty) ----------
# Option A: leave these blank and complete setup in the browser.
# Option B: create the owner account automatically (password must be changed on first sign-in).
COMPANY_NAME=Company X
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Option C: sample data for evaluation. Never enable on a real company's instance.
SEED_DEMO=false
DEMO_PASSWORD=Demo1234

# ---------- email (any SMTP provider: Resend, Postmark, SendGrid, Mailgun, Google Workspace) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=crm@companyx.com

# ---------- SMS (Twilio) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15555550100

# ---------- subscription billing (YOUR Stripe account, charging this client) ----------
# Leave STRIPE_SECRET_KEY empty to turn billing off (nothing is ever locked).
STRIPE_SECRET_KEY=
# The recurring Price the client subscribes to (Stripe → Product catalog → your plan → Price ID).
STRIPE_PRICE_ID=
# Add a webhook endpoint in Stripe pointing at https://<client-app>/api/billing/webhook
# (events: checkout.session.completed, customer.subscription.*, invoice.paid, invoice.payment_failed)
STRIPE_WEBHOOK_SECRET=
# Free days before a subscription is required, counted from first boot.
TRIAL_DAYS=14
# Days a failed payment keeps working before the workspace turns read-only.
BILLING_GRACE_DAYS=7
# Set to "active" to comp this client (billing on, never locks).
BILLING_OVERRIDE=
